#!/usr/bin/env bash
# The room's phone stopped answering: the same phone again, on the same
# port (so the same serial the screen drives), booted and opened fresh.
set -euo pipefail
here=$ADMINISTRATION_EQUIPMENT_DIR
serial=$(cat "$here/serial")
port=${serial#emulator-}
"$ANDROID_HOME/platform-tools/adb" -s "$serial" emu kill >/dev/null 2>&1 || true
for _ in $(seq 30); do
  (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null || break
  sleep 1
done
. "$(dirname "$0")/boot"
