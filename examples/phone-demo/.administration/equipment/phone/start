#!/usr/bin/env bash
# A fresh phone for the room: an emulator of the person's AVD (one kept for
# rooms, not the one used for development), read-only so rooms can share
# it, and the app it tests running on the room's port (the phone reaches
# the computer at 10.0.2.2).
set -euo pipefail
: "${ANDROID_HOME:?the Android SDK (pass_env)}" "${ADMINISTRATION_AVD:?the AVD to boot (pass_env)}"
adb=$ANDROID_HOME/platform-tools/adb
here=$ADMINISTRATION_EQUIPMENT_DIR
mkdir -p "$here"

cp -R "$ADMINISTRATION_MAIN/app" "$here/notes"
python3 "$here/notes/server.py" "$ADMINISTRATION_PORT" >"$here/notes.log" 2>&1 </dev/null &
echo "$ADMINISTRATION_PORT" > "$here/app-port"

# A console port in the rooms' range (ADMINISTRATION_DEVICE_PORTS, even
# ports; the emulator takes the odd one above for adb) that no other room
# holds, claimed with mkdir. A port held by anything else (a development
# emulator someone started in the range) is passed over, never shared: a
# room's emulator next to a stranger on its port crashed twice.
first=${ADMINISTRATION_DEVICE_PORTS%-*} last=${ADMINISTRATION_DEVICE_PORTS#*-}
claims=${TMPDIR:-/tmp}/phone-demo-claims
mkdir -p "$claims"
# A claim is a hint between rooms starting at once, and goes stale after
# half an hour even while its room lives: the probe below (is the port
# held, does adb list it) is what keeps two phones off one port.
find "$claims" -mindepth 1 -maxdepth 1 -mmin +30 -exec rmdir {} + 2>/dev/null || true
"$adb" start-server >/dev/null 2>&1 || true
devices=$("$adb" devices 2>/dev/null | awk '{print $1}')
held() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
port=
for p in $(seq "$first" 2 "$last"); do
  if mkdir "$claims/$p" 2>/dev/null; then
    if held "$p" || held $((p + 1)) || grep -qx "emulator-$p" <<<"$devices"; then
      echo "port $p is held by a device that isn't a room's; passing it over" >&2
      rmdir "$claims/$p"; continue
    fi
    port=$p; break
  fi
done
[ -n "$port" ] || { echo "no free emulator port in $ADMINISTRATION_DEVICE_PORTS" >&2; exit 1; }
echo "$claims/$port" > "$here/claim"
serial=emulator-$port
echo "$serial" > "$here/serial"

. "$(dirname "$0")/boot"
echo "SERIAL=$serial"
# What it runs: the app copied from the checkout, so the checkout's commit.
echo "BUILD_COMMIT=$(git -C "$ADMINISTRATION_MAIN" rev-parse HEAD 2>/dev/null || true)"
