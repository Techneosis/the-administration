#!/usr/bin/env bash
# Boots the room's phone on $port and opens the app: the part of start that
# restart runs again. Sourced, with port, serial and here set.
adb=$ANDROID_HOME/platform-tools/adb
# The adb server first: adb scans only the low console ports itself, so an
# emulator in the rooms' range is seen only when it registers with a
# server already running (a restart may find the server gone).
"$adb" start-server >/dev/null 2>&1 || true
window=-no-window
[ "${ADMINISTRATION_SHOW:-}" = 1 ] && window=
"$ANDROID_HOME/emulator/emulator" -avd "$ADMINISTRATION_AVD" -read-only -no-snapshot \
  -no-audio -no-boot-anim $window -port "$port" >"$here/emulator.log" 2>&1 </dev/null &
emu=$!

for _ in $(seq 180); do
  [ "$("$adb" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break
  kill -0 "$emu" 2>/dev/null || { tail -5 "$here/emulator.log" >&2; exit 1; }
  sleep 1
done
[ "$("$adb" -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] || { echo "the phone didn't boot" >&2; exit 1; }
# Only the build under test: an AVD's snapshot can carry an old app, and
# whoever opens it judges the wrong one. (Read-only, so it's forgotten
# when the emulator goes.) The demo tests a page in the system browser, so
# every third-party package goes; a real app keeps its own package here.
for pkg in $("$adb" -s "$serial" shell pm list packages -3 2>/dev/null | tr -d '\r' | sed 's/^package://'); do
  [ "$pkg" = "${KEEP_PACKAGE:-}" ] || "$adb" -s "$serial" uninstall "$pkg" >/dev/null 2>&1 || true
done
# Its network comes up a moment after boot; the app is unreachable without it.
for _ in $(seq 60); do
  "$adb" -s "$serial" shell ping -c1 -W1 10.0.2.2 >/dev/null 2>&1 && break
  sleep 1
done
"$adb" -s "$serial" shell ping -c1 -W1 10.0.2.2 >/dev/null 2>&1 || { echo "the phone has no network" >&2; exit 1; }
"$adb" -s "$serial" shell input keyevent 82 >/dev/null   # wake and unlock
"$adb" -s "$serial" shell am start -a android.intent.action.VIEW \
  -d "http://10.0.2.2:$(cat "$here/app-port")/" org.chromium.webview_shell >/dev/null
sleep 3
